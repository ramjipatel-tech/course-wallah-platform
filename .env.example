# ==============================================================================
# COURSE WALLAH CONTENT PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 🔑 TELEGRAM BOT CONFIGURATION
API_ID=12345678
API_HASH=your_telegram_api_hash_here
BOT_TOKEN=your_telegram_bot_token_here
BOT_NAME=Course Wallah
BOT_USERNAME=@course_wallah_officalbot
OWNER_ID=123456789
ADMINS=123456789,987654321

# 🗄️ DATABASE
# On Railway: Add a PostgreSQL plugin -> DATABASE_URL is set automatically!
# For SQLite local dev:
DATABASE_URL=sqlite+aiosqlite:///./data/course_wallah.db
# For Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/railway

# ☁️ BACKBLAZE B2 STORAGE (Private S3-Compatible Storage for Secure PDFs)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=course-wallah-pdfs
B2_KEY_ID=your_b2_key_id_here
B2_APPLICATION_KEY=your_b2_application_key_here

# 🎬 YOUTUBE DATA API V3 (Server-Side Multi-Channel Resumable Uploads)
# Note: You can also add/manage multiple YouTube channels directly from the Telegram bot using /yt_add!
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_DEFAULT_PRIVACY=unlisted

# 🎨 DYNAMIC WATERMARK ENGINE
WATERMARK_TEXT=COURSE WALLAH
WATERMARK_OPACITY=0.45
WATERMARK_CRF=26
WATERMARK_SPEED=8

# 🔐 SECURITY & ADMIN PANEL ACCESS
SECRET_KEY=generate_a_random_64_character_secret_key_here
ADMIN_SECRET_PATH=ragni
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CourseWallah@2026#Secure
SECURITY_TEST_MODE=false

# 🌐 DOMAIN & DEPLOYMENT URLS
# On Railway:
PORT=8000
API_URL=https://your-backend.up.railway.app
SITE_URL=https://your-frontend.vercel.app

# On Vercel (Next.js Frontend):
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_SITE_NAME=Course Wallah
